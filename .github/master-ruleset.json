{
  "name": "master protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/master"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": [
          "squash",
          "rebase"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Go — fmt, vet, build, test (race)",
            "integration_id": 15368
          },
          {
            "context": "Frontend — lint, build, test",
            "integration_id": 15368
          },
          {
            "context": "Integration — containerized Swift (SAIO)",
            "integration_id": 15368
          },
          {
            "context": "Smoke — headless app against mock Swift",
            "integration_id": 15368
          },
          {
            "context": "CI — all required jobs passed",
            "integration_id": 15368
          }
        ]
      }
    }
  ],
  "bypass_actors": []
}
