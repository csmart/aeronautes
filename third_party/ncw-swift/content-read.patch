+type ownedCancelledCloseBody struct {
+	ctx   context.Context
+	extra error
+}
+
+func (b *ownedCancelledCloseBody) Read([]byte) (int, error) { <-b.ctx.Done(); return 0, b.ctx.Err() }
+func (b *ownedCancelledCloseBody) Close() error             { return errors.Join(b.ctx.Err(), b.extra) }
