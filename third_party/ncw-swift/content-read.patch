+type ownedErrorBody struct {
+	ctx   context.Context
+	extra error
+}
+
+func (b *ownedErrorBody) Read([]byte) (int, error) {
+	<-b.ctx.Done()
+	return 0, errors.Join(b.ctx.Err(), b.extra)
+}
+func (b *ownedErrorBody) Close() error { return nil }
